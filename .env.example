# Local-only PostgreSQL configuration. Change the password for shared environments.
POSTGRES_DB=lankallm
POSTGRES_USER=lankallm
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lankallm:local-development-only@localhost:5432/lankallm

# Provider credentials are intentionally blank and must never be committed.
OPENAI_API_KEY=
GOOGLE_API_KEY=
